---
// You can change these variables to update your site easily!
const name = "Jacob Gumulak";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{name} | Portfolio</title>
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<style>
			:root {
				--primary: #3b82f6;
				--text: #1f2937;
				--bg: #ffffff;
			}
			body { 
				font-family: 'Inter', sans-serif; 
				line-height: 1.6; 
				color: var(--text); 
				margin: 0;
				background-color: var(--bg);
			}
			.container {
				max-width: 800px;
				margin: 0 auto;
				padding: 4rem 2rem;
			}
			header {
				margin-bottom: 3rem;
			}
			h1 {
				font-size: 3rem;
				margin: 0;
				color: #111;
			}
			.role {
				color: var(--primary);
				font-weight: 600;
				font-size: 1.25rem;
			}
			.about-section {
				background: #f9fafb;
				padding: 2rem;
				border-radius: 1rem;
				border: 1px solid #e5e7eb;
			}
			h2 {
				margin-top: 0;
				font-size: 1.5rem;
			}
			p {
				font-size: 1.125rem;
				color: #4b5563;
			}

			.school-link {
  				color: #00267A;
  				text-decoration: none;
  				font-weight: 600;
  				border-bottom: 1px solid transparent;
  				transition: all 0.2s ease;
			}
			.email-link {
  				color: #3b82f6;
				text-decoration: none;
				font-weight: 500;
				padding: 4px 8px;
				background: #eff6ff;
				border-radius: 3px;
				transition: all 0.2s;
			}
			.email-link:hover {
  				background: #dbeafe;
  				color: #1d4ed8;
			}
			.navbar {
				background-color: #ffffff;
				border-bottom: 1px solid #e5e7eb;
				padding: 1rem 0;
				position: sticky;
				top: 0;
				z-index: 100;
			}

			.nav-container {
				max-width: 800px;
				margin: 0 auto;
				display: flex;
				align-items: center;
				padding: 0 1.5rem;
			}

			.nav-link {
			text-decoration: none;
			color: #4b5563;
			font-weight: 500;
			font-size: 1rem;
			transition: color 0.2s;
			padding: 0.5rem 0.75rem; /* Makes the clickable area bigger for thumbs */
			}

			/* Welcome Section */
.welcome-section {
  text-align: center;
  max-width: 800px;
  margin: 4rem auto;
  padding: 0 1.5rem;
}

.welcome-section h1 {
  font-size: 2.5rem;
  color: #111;
  margin-bottom: 1.5rem;
}

.welcome-section p {
  font-size: 1.2rem;
  line-height: 1.8;
  color: #4b5563;
}

/* Tile Grid Container */
.tile-grid {
  display: grid;
  /* 'auto-fit' tells the grid to fill the row; 'minmax' prevents squishing */
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
  gap: 2rem;
  max-width: 1100px;
  margin: 0 auto 5rem;
  padding: 0 2rem;
  width: 100%;
  box-sizing: border-box;
}

/* Individual Tiles */
.tile {
  background: white;
  padding: 2.5rem 1.5rem;
  border-radius: 15px;
  text-decoration: none;
  text-align: center;
  border: 1px solid #e5e7eb;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  
  /* Flexbox inside the tile keeps content centered */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  
  /* Ensures padding doesn't add to the width and cause overlaps */
  box-sizing: border-box; 
  width: 100%;
}

.tile:hover {
  transform: translateY(-10px);
  border-color: #2563eb;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
}

/* Mobile Specific Tweaks */
@media (max-width: 600px) {
  .tile-grid {
    /* Less columns on mobile, forced to 1 column if screen is very small */
    grid-template-columns: 1fr; 
    padding: 0 1.5rem;
  }
}
}

			@media (max-width: 600px) {
			.nav-container {
				flex-wrap: wrap; /* Allows tabs to drop to a second line if needed */
				justify-content: center; /* Centers tabs on mobile */
				gap: 0.5rem;
			}
			
			.nav-link {
				font-size: 0.9rem; /* Slightly smaller text for mobile */
				padding: 0.4rem 0.6rem;
				background: #f3f4f6; /* Adds a light "button" feel to each tab */
				border-radius: 6px;
			}

			.contact-tab {
				margin-left: 0; /* Resets the "push to right" on mobile */
				width: 100%; /* Makes contact button full width on mobile */
				text-align: center;
				margin-top: 0.5rem;
			}
			}

			.nav-link:hover {
				color: #3b82f6; /* Turns blue when you hover */
			}

			.school-link:hover {
  				color: #2563eb; /* Darker blue on hover */
  				border-bottom: 1px solid #2563eb; /* Underline appears only on hover */
			}
		</style>
	</head>
	<body>
		<nav class="navbar">
