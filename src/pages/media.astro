---
// You can change these variables to update your site easily!
const name = "Media";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{name} | Portfolio</title>
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<style>
			:root {
				--primary: #3b82f6;
				--text: #1f2937;
				--bg: #ffffff;
			}
			body { 
				font-family: 'Inter', sans-serif; 
				line-height: 1.6; 
				color: var(--text); 
				margin: 0;
				background-color: var(--bg);
			}
			.container {
				max-width: 800px;
				margin: 0 auto;
				padding: 4rem 2rem;
			}
			header {
				margin-bottom: 3rem;
			}
			h1 {
				font-size: 3rem;
				margin: 0;
				color: #111;
			}
			.role {
				color: var(--primary);
				font-weight: 600;
				font-size: 1.25rem;
			}
			.about-section {
				background: #f9fafb;
				padding: 2rem;
				border-radius: 1rem;
				border: 1px solid #e5e7eb;
			}
			h2 {
				margin-top: 0;
				font-size: 1.5rem;
			}
			p {
				font-size: 1.125rem;
				color: #4b5563;
			}
			.status {
				display: inline-block;
				margin-top: 1rem;
				padding: 0.25rem 0.75rem;
				background: #dcfce7;
				color: #166534;
				border-radius: 9999px;
				font-size: 0.875rem;
				font-weight: 500;
			}
			.school-link {
  				color: #00267A;
  				text-decoration: none;
  				font-weight: 600;
  				border-bottom: 1px solid transparent;
  				transition: all 0.2s ease;
			}
			.email-link {
  				color: #3b82f6;
				text-decoration: none;
				font-weight: 500;
				padding: 4px 8px;
				background: #eff6ff; /* Very light blue background */
				border-radius: 4px;
				transition: all 0.2s;
			}
			.email-link:hover {
  				background: #dbeafe; /* Slightly darker blue on hover */
  				color: #1d4ed8;
			}
			.navbar {
				background-color: #ffffff;
				border-bottom: 1px solid #e5e7eb;
				padding: 1rem 0;
				position: sticky; /* This keeps the menu at the top when you scroll */
				top: 0;
				z-index: 100;
			}

						/* Base styles for all devices */
			.nav-container {
				max-width: 800px;
				margin: 0 auto;
				display: flex;
				align-items: center;
				padding: 0 1.5rem;
			}

			.nav-link {
			text-decoration: none;
			color: #4b5563;
			font-weight: 500;
			font-size: 1rem;
			transition: color 0.2s;
			padding: 0.5rem 0.75rem; /* Makes the clickable area bigger for thumbs */
			}

			/* 📱 Mobile Specific Styles (Screens smaller than 600px) */
			@media (max-width: 600px) {
			.nav-container {
				flex-wrap: wrap; /* Allows tabs to drop to a second line if needed */
				justify-content: center; /* Centers tabs on mobile */
				gap: 0.5rem;
			}
			
			.nav-link {
				font-size: 0.9rem; /* Slightly smaller text for mobile */
				padding: 0.4rem 0.6rem;
				background: #f3f4f6; /* Adds a light "button" feel to each tab */
				border-radius: 6px;
			}

			.contact-tab {
				margin-left: 0; /* Resets the "push to right" on mobile */
				width: 100%; /* Makes contact button full width on mobile */
				text-align: center;
				margin-top: 0.5rem;
			}
			}

			.nav-link:hover {
				color: #3b82f6; /* Turns blue when you hover */
			}

			.school-link:hover {
  				color: #2563eb; /* Darker blue on hover */
  				border-bottom: 1px solid #2563eb; /* Underline appears only on hover */
			}
		</style>
	</head>
	<body>
		<nav class="navbar">
  			<div class="nav-container">
    			<a href="/" class="nav-link">Home</a>
    			<a href="/about" class="nav-link">About</a>
    			<a href="/lessons" class="nav-link">Lesson Plans</a>
    			<a href="/media" class="nav-link">Media</a>
    			<a href="mailto:your@email.com" class="nav-link contact-tab">Contact</a>
  	</div>
</nav>
		<main class="container">
			<header>
				<h1>{name}</h1>
			</header>

			<section class="about-section">
				<h2>Welcome!</h2>
				<p>Thank you for visiting my e-portfolio! My name is Jacob Gumulak, an upcoming graduate of <a href="https://www.moravian.edu" target="_blank" class="school-link"> Moravian University </a>, majoring in PK-12 Music Education with a concentration in Jazz Saxophone. On this website, you will find information on my personal growth and development as an educator and musician, snapshots of my classroom teaching and performances, my teaching philosophy, as well as a little about me outside of music. If you have any questions, please feel free to contact me via email (<a href="mailto:jacobgumulak@gmail.com" class="email-link">jacobgumulak@gmail.com</a>), or by cell at (908)-619-7586 .</p>
				<div class="status">🟢 fard</div>
			</section>
		</main>
	</body>
</html>