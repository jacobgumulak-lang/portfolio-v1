---
import Layout from '../layouts/Layout.astro';
const name = "Resume";
---

<Layout showNav={true}>
  <div class="page-wrapper">
    <main class="content-card">

      <section class="resume-container">
        <header class="resume-header">
          <h2>Jacob Gumulak</h2>
          <p>
            jacobgumulak@gmail.com | (908)-619-7586 | Bethlehem, PA
          </p>
          <p>
            <a href="https://drive.google.com/file/d/1mdw6mxp3Ke8vRkdmUZuiLHuwUyqijkZI/view?usp=sharing" target="_blank" class="coverletter-link">Cover Letter</a>
          </p>
        </header>

        <div class="resume-section">
          <h3>Education</h3>
          <div class="entry">
            <div class="row">
              <strong>Moravian University</strong>
              <span>Bethlehem, PA</span>
            </div>
            <div class="row">
              <span>Bachelor of Music, PK-12 Education</span>
              <span>May 2026</span>
            </div>
            <p class="stats">GPA: 3.02 | Dean’s List (2025)</p>
            <p class="awards">
              <strong>Awards & Honors:</strong> Winner, Moravian University Concerto Competition (2025); Al Lazaro Memorial Jazz Prize (2025); Distinguished Young Musician Award (2022-2026); John H. Reimers Music Scholarship (2025-2026).
            </p>
          </div>
        </div>

        <div class="resume-section">
          <h3>Field Experience</h3>
          
          <div class="entry">
            <div class="row">
              <strong>Southern Lehigh High School</strong>
              <span>Center Valley, PA</span>
            </div>
            <p class="role">Student Teaching: 9-12 Band, Orchestra, Jazz, & 4th Grade Instrumental | March–May 2026</p>
            <ul>
              <li>Co-taught concert band, string orchestra, symphony orchestra, and two jazz ensembles.</li>
              <li>Taught fourth grade band lessons at the intermediate school level.</li>
            </ul>
          </div>

          <div class="entry">
            <div class="row">
              <strong>Cheston/March Elementary Schools</strong>
              <span>Easton, PA</span>
            </div>
            <p class="role">Student Teaching: 4th–5th Grade Instrumental Music | Jan–March 2026</p>
            <ul>
              <li>Managed instrumental lessons and ensembles across two elementary school buildings.</li>
            </ul>
          </div>

          <div class="entry">
            <div class="row">
              <strong>Northampton Area Middle School</strong>
              <span>Northampton, PA</span>
            </div>
            <p class="role">Pre-Student Teaching: 7th–8th Grade General Music and Choir | Sept–Nov 2025</p>
            <ul>
              <li>Integrated technology into 8th grade general music to teach jazz history.</li>
              <li>Led 7th grade choir rehearsals using functional piano skills and Kodály methods.</li>
            </ul>
          </div>
        </div>

        <div class="resume-section">
          <h3>Research & Presentations</h3>
          <div class="entry">
            <strong>Lead Researcher: Rediscovering the Hollywood Saxophone Quartet (SOAR)</strong>
            <ul>
              <li>Presented findings at the Jazz Education Network (JEN) Conference in Atlanta, GA (Jan 2025).</li>
              <li>Invited to perform at the COTA festival (Sept 2025) and PMEA Conference (April 2026).</li>
              <li>Co-researched history and music using academic resources and University-owned materials.</li>
            </ul>
          </div>
        </div>

        <div class="resume-section">
          <h3>Skills & Certifications</h3>
          <p><strong>Musicianship:</strong> Concentration in Jazz Saxophone; Proficient in Woodwinds, Brass, Strings, and Percussion. Active in University Choir, Jazz Band, and Saxophone Quartet.</p>
          <p><strong>Technology:</strong> Proficient in Musescore, Finale, Soundtrap, Garageband, FL Studio, SmartMusic, Flat.io, and Canva.</p>
          <p><strong>Certifications & Clearances:</strong> CPR/AED/First Aid Certified (Exp. 2028). PA Clearances: Act 34, 151, 114.</p>
          <p><strong>Affiliations:</strong> NAfME, PMEA, JEN.</p>
        </div>

        <div class="button-container">
          <a href="/jacob.gumulak.resume.pdf" download class="download-button">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Download My Resume
          </a>
        </div>

      </section>
    </main>
  </div>
</Layout>

<style>
  /* 1. Page Background Alignment */
  .page-wrapper {
    display: flex;
    justify-content: center;
    padding: 4rem 2rem;
  }

  /* 2. The Glass Box (Content Card) */
  .content-card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    max-width: 900px;
    width: 100%;
    padding: 3.5rem;
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  /* 3. Clean Header Gap */
  .header-clean {
    margin-bottom: 4rem;
  }

  h1 {
    font-size: 3rem;
    margin: 0;
    color: #111;
    font-weight: 800;
  }

  /* 4. Resume Body Styling */
  .resume-header {
    text-align: center;
    border-bottom: 2px solid #111;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
  }

  .resume-header h2 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem 0;
    color: #111;
  }

  .resume-section {
    margin-bottom: 2.5rem;
  }

  .resume-section h3 {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #2563eb;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 1rem;
    padding-bottom: 0.25rem;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.25rem;
  }

  .role {
    font-style: italic;
    font-weight: 500;
    color: #4b5563;
    margin: 0.25rem 0;
  }

  .stats, .awards {
    font-size: 0.95rem;
    margin: 0.5rem 0;
  }

  ul {
    margin-top: 0.5rem;
    padding-left: 1.5rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  /* 5. Links & Button Styling */
  .coverletter-link {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 500;
    padding: 4px 8px;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 4px;
    transition: all 0.2s;
  }

  .coverletter-link:hover {
    background: rgba(59, 130, 246, 0.2);
    color: #1d4ed8;
  }

  .button-container {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .download-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #2563eb;
    color: white;
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.2s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .download-button:hover {
    background-color: #1d4ed8;
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
  }

  .icon {
    margin-top: 2px;
  }

@media (max-width: 600px) {
  .content-card {
    padding: 1.5rem; /* Less internal padding */
    border-radius: 16px; /* Slightly smaller corners for small screens */
    width: 100%;
    margin: 0; /* Ensure it doesn't push outside the wrapper */
  }

  .header-clean h1 {
    font-size: 2.2rem; /* Shrink title so it doesn't wrap awkwardly */
  }

  /* For Resume: ensure the rows (Education/Experience) stack vertically */
  .row {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
}
</style>