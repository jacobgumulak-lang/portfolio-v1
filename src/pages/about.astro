---
import Layout from '../layouts/Layout.astro';
const name = "About Me";
---

<Layout showNav={true}>
  <main class="container">
    <section class="content-card">
      <header>
        <h1>{name}</h1>
      </header>
      
      <section class="about-content">
        <p>
         This is the About section.
        </p>
      </section>
    </section>
  </main>
</Layout>

<style>
  /* Local page styling */
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

.content-card {
    background: rgba(255, 255, 255, 0.85); /* Slightly more solid than the nav for readability */
    padding: 3rem;
    border-radius: 24px; /* Rounder corners like your image */
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
    margin-top: 4rem;
    margin-bottom: 4rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

h1 {
    font-size: 3rem;
    margin-top: 0;
    margin-bottom: 2.5rem;
    color: #111;
    font-weight: 800;
  }

  .about-content p {
    font-size: 1.2rem;
    line-height: 1.8;
    color: #374151;
    margin-bottom: 1.5rem;
  }
</style>