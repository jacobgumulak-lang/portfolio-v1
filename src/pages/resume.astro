---
const name = "Resume";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{name} | Portfolio</title>
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<style>
			:root {
				--primary: #3b82f6;
				--text: #1f2937;
				--bg: #ffffff;
			}
			body { 
				font-family: 'Inter', sans-serif; 
				line-height: 1.6; 
				color: var(--text); 
				margin: 0;
				background-color: var(--bg);
			}
			.container {
				max-width: 800px;
				margin: 0 auto;
				padding: 4rem 2rem;
			}
			header {
				margin-bottom: 3rem;
			}
			h1 {
				font-size: 3rem;
				margin: 0;
				color: #111;
			}
			.role {
				color: var(--primary);
				font-weight: 600;
				font-size: 1.25rem;
			}
			.about-section {
				background: #f9fafb;
				padding: 2rem;
				border-radius: 1rem;
				border: 1px solid #e5e7eb;
			}
			h2 {
				margin-top: 0;
				font-size: 1.5rem;
			}
			p {
				font-size: 1.125rem;
				color: #4b5563;
			}

			.school-link {
  				color: #00267A;
  				text-decoration: none;
  				font-weight: 600;
  				border-bottom: 1px solid transparent;
  				transition: all 0.2s ease;
			}

            .coverletter-link {
                color: #3b82f6;
                text-decoration: none;
                font-weight: 400;
            }
			.email-link {
  				color: #3b82f6;
				text-decoration: none;
				font-weight: 500;
				padding: 4px 8px;
				background: #eff6ff;
				border-radius: 3px;
				transition: all 0.2s;
			}
			.email-link:hover {
  				background: #dbeafe;
  				color: #1d4ed8;
			}
			.navbar {
				background-color: #ffffff;
				border-bottom: 1px solid #e5e7eb;
				padding: 1rem 0;
				position: sticky;
				top: 0;
				z-index: 100;
			}

			.nav-container {
				max-width: 800px;
				margin: 0 auto;
				display: flex;
				align-items: center;
				padding: 0 1.5rem;
			}

			.nav-link {
			text-decoration: none;
			color: #4b5563;
			font-weight: 500;
			font-size: 1rem;
			transition: color 0.2s;
			padding: 0.5rem 0.75rem;
			}

			@media (max-width: 600px) {
			.nav-container {
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5rem;
			}
			
			.nav-link {
				font-size: 0.9rem;
				padding: 0.4rem 0.6rem;
				background: #f3f4f6;
				border-radius: 6px;
			}

			.contact-tab {
				margin-left: 0;
				width: 100%;
				text-align: center;
				margin-top: 0.5rem;
			}
			}

			.nav-link:hover {
				color: #3b82f6;
			}

			.school-link:hover {
  				color: #2563eb;
  				border-bottom: 1px solid #2563eb;
			}
.resume-container {
  max-width: 800px;
  margin: 0 auto;
  line-height: 1.6;
  color: #1f2937;
}

.resume-header {
  text-align: center;
  border-bottom: 2px solid #111;
  margin-bottom: 2.5rem;
  padding-bottom: 1rem;
}

.resume-header h1 {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

.resume-section {
  margin-bottom: 2rem;
}

.resume-section h3 {
  font-size: 1.2rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #2563eb;
  border-bottom: 1px solid #e5e7eb;
  margin-bottom: 1rem;
  padding-bottom: 0.25rem;
}

.entry {
  margin-bottom: 1.5rem;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.role {
  font-style: italic;
  font-weight: 500;
  color: #4b5563;
  margin: 0.25rem 0;
}

.stats, .awards {
  font-size: 0.95rem;
  margin: 0.5rem 0;
}

ul {
  margin-top: 0.5rem;
  padding-left: 1.5rem;
}

li {
  margin-bottom: 0.5rem;
}

@media (max-width: 600px) {
  .row {
    flex-direction: column;
  }
}
		</style>
	</head>
	<body>
		<nav class="navbar">
  			<div class="nav-container">
    			<a href="/" class="nav-link">Home</a>
    			<a href="/about" class="nav-link">About</a>
    			<a href="/lessons" class="nav-link">Lesson Plans</a>
    			<a href="/media" class="nav-link">Media</a>
                <a href="/philosophy" class="nav-link">Philosophy</a>
				<a href="/resume" class="nav-link">Resume</a>
  	</div>
</nav>
		<main class="container">
<section class="resume-container">
<section class="resume-container">
  <header class="resume-header">
    <h1>Jacob Gumulak</h1>
