---
import Layout from '../layouts/Layout.astro';
const name = "Media";
---

<Layout showNav={true}>
  <div class="page-wrapper">
    <main class="content-card">
      
      <header class="header-clean">
        <h1>{name}</h1>
      </header>

      <section class="media-grid">
        
        <div class="video-container">
          <iframe 
            src="https://www.youtube.com/embed/uO6Z5FiQ3k8?si=mMbG3b0tS4yKQCoh&amp;start=20" 
            title="YouTube video player" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin" 
            allowfullscreen>
          </iframe>
          <div class="title-frame-below">
            <p class="video-caption">
              Performance Highlight: André Waignein's "Rhapsody for Alto Saxophone and Orchestra" with the Moravian University Community Orchestra
            </p>
          </div>
        </div>

        <div class="video-container">
          <iframe 
            src="https://www.youtube.com/embed/g2U-y9OWqSg?si=5ho0s7IeSZaBP9tb&amp;start=86" 
            title="YouTube video player" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin" 
            allowfullscreen>
          </iframe>
          <div class="title-frame-below">
            <p class="video-caption">
              Performance Highlight: Kris Berg's "Lifelong Friends" with the Moravian University BIG Band
            </p>
          </div>
        </div>

        <div class="video-container">
          <iframe 
            src="https://drive.google.com/file/d/1xDfBHsegva9u2NhxF7AiSvaUO3Mkq68Q/preview" 
            title="Google Drive video player" 
            allow="autoplay" 
            allowfullscreen>
          </iframe>
          <div class="title-frame-below">
            <p class="video-caption">
              Conducting: Serenade no. 9 Finale "Posthorn" - Mozart, played by the Southern Lehigh High School Symphony Orchestra
            </p>
          </div>
        </div>

      </section>
    </main>
  </div>
</Layout>

<style>
  .page-wrapper {
    display: flex;
    justify-content: center;
    padding: 4rem 2rem;
  }

  .content-card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    max-width: 900px;
    width: 100%;
    padding: 3.5rem;
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  /* --- HEADER CLEAN UP --- */
  .header-clean {
    margin-bottom: 4rem;
    /* Removed all borders and backgrounds */
  }

  h1 {
    font-size: 3rem;
    margin: 0;
    color: #111;
    font-weight: 800;
  }

  /* --- VIDEO WRAPPER & SPACING --- */
  .video-container {
    margin-bottom: 7rem;
    width: 100%;
  }

  .title-frame-below {
    padding: 1.5rem;
    background-color: rgba(249, 250, 251, 0.6); 
    border-left: 5px solid #2563eb;
    margin-top: 1.5rem;
    border-radius: 0 8px 8px 0;
  }

  .video-caption {
    margin: 0;
    font-size: 1.1rem;
    color: #1f2937;
    font-weight: 600;
    line-height: 1.5;
  }

  iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 600px) {
    .page-wrapper { padding: 2rem 1rem; }
    .content-card { padding: 1.5rem; }
    h1 { font-size: 2.2rem; }
    .video-container { margin-bottom: 4rem; }
  }
</style>