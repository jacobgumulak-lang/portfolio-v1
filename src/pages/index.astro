---
import Layout from '../layouts/Layout.astro';
const name = "Jacob Gumulak";
---

<Layout showNav={false}>
    <main class="container">
        <header class="welcome-header">
            <h1>{name}</h1>
        </header>

        <section class="about-card">
            <h2>Welcome!</h2>
            <p>
                Thank you for visiting my e-portfolio! My name is Jacob Gumulak, an upcoming graduate of 
                <a href="https://www.moravian.edu" target="_blank" class="school-link">Moravian University</a>, 
                majoring in PK-12 Music Education with a concentration in Jazz Saxophone. 
            </p>
            <p>
                On this website, you will find information on my personal growth and development as an educator and musician, 
                snapshots of my classroom teaching and performances, my teaching philosophy, as well as a little about me 
                outside of music. 
            </p>
            <div class="contact-info">
                <p>
                    Questions? Contact me via email: 
                    <a href="mailto:jacobgumulak@gmail.com" class="email-link">jacobgumulak@gmail.com</a> 
                    or by cell at <strong>(908)-619-7586</strong>.
                </p>
            </div>
        </section>

        <div class="tile-grid">
            <a href="/philosophy" class="tile">
                <h3>Philosophy</h3>
                <p>My approach to K-12 and Instrumental music education.</p>
            </a>

            <a href="/about" class="tile">
                <h3>About Me</h3>
                <p>My background, journey, and life outside of the classroom.</p>
            </a>

            <a href="/lessons" class="tile">
                <h3>Lesson Plans</h3>
                <p>Curriculum materials and interactive teaching resources.</p>
            </a>

            <a href="/media" class="tile">
                <h3>Media</h3>
                <p>Performance videos, conducting, and classroom observations.</p>
            </a>

            <a href="/resume" class="tile">
                <h3>Resume</h3>
                <p>View my professional experience and field work.</p>
            </a>
        </div>
    </main>
</Layout>

<style>
    .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .welcome-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .welcome-header h1 {
        font-size: 3.5rem;
        margin: 0;
        color: #ffffff; /* Your requested white text */
        text-shadow: 0 2px 4px rgba(0,0,0,0.3); /* Slightly stronger shadow for readability */
    }

    .about-card {
        background: rgba(255, 255, 255, 0.92);
        padding: 2.5rem;
        border-radius: 20px;
        margin-bottom: 4rem;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        border: 1px solid rgba(255,255,255,0.3);
    }

    .about-card h2 {
        margin-top: 0;
        font-size: 2rem;
        color: #111;
    }

    .about-card p {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #374151;
        margin-bottom: 1.5rem;
    }

    .contact-info {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
    }

    .school-link {
        color: #00267A;
        font-weight: 700;
        text-decoration: underline;
    }

    .email-link {
        color: #2563eb;
        font-weight: 600;
        text-decoration: none;
    }

    .tile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-bottom: 5rem;
    }

    .tile {
        background: white;
        padding: 2.5rem 1.5rem;
        border-radius: 15px;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border: 1px solid #e5e7eb;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .tile:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 25px rgba(0,0,0,0.1);
        border-color: #2563eb;
    }

    .tile h3 {
        font-size: 1.5rem;
        margin: 0.5rem 0;
        color: #000000; /* Your requested black text */
    }

    .tile p {
        font-size: 1rem;
        color: #6b7280;
        margin: 0;
    }

@media (max-width: 600px) {
  .content-card {
    padding: 1.5rem; /* Less internal padding */
    border-radius: 16px; /* Slightly smaller corners for small screens */
    width: 100%;
    margin: 0; /* Ensure it doesn't push outside the wrapper */
  }

  .header-clean h1 {
    font-size: 2.2rem; /* Shrink title so it doesn't wrap awkwardly */
  }

  /* For Resume: ensure the rows (Education/Experience) stack vertically */
  .row {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
}
</style>